{% extends 'layout/main.html.twig' %}

{% block title %}Statistiques - EventCampus{% endblock %}

{% block content %}
    <h1>Statistiques</h1>
    <p>{{ total }} événements au total.</p>

    <ul>
        {% for categorie, nombre in parCategorie %}
            <li>{{ categorie }} : {{ nombre }} ({{ (nombre / total * 100)|round }} %)</li>
        {% endfor %}
    </ul>
{% endblock %}
