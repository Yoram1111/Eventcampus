{% extends 'layout/main.html.twig' %}

{% block title %}Événements - EventCampus{% endblock %}

{% block content %}
    <h1>Tous les événements</h1>

    <p>
        Catégories :
        {% for cat in categories %}
            <a href="{{ path('app_evenement_categorie', {categorie: cat}) }}">{{ cat }}</a>
        {% endfor %}
    </p>

    <div class="row">
        {% for evenement in evenements %}
            <div class="col-md-4 mb-4">{% include 'components/evenement_card.html.twig' %}</div>
        {% endfor %}
    </div>
{% endblock %}
