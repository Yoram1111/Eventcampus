{% extends 'layout/main.html.twig' %}

{% block title %}Événements - EventCampus{% endblock %}

{% block content %}
    <h1>Tous les événements</h1>

    <div class="mb-4">
        <a href="{{ path('app_evenement_index') }}" class="btn btn-primary btn-sm">Tous</a>
        {% for cat in categories %}
            <a href="{{ path('app_evenement_categorie', {categorie: cat}) }}" class="btn btn-outline-primary btn-sm">{{ cat|capitalize }}</a>
        {% endfor %}
    </div>

    <div class="row">
        {% for evenement in evenements %}
            <div class="col-md-6 col-lg-4 mb-4">
                {% include 'components/evenement_card.html.twig' with { 'evenement': evenement } %}
            </div>
        {% else %}
            <p>Aucun événement.</p>
        {% endfor %}
    </div>
{% endblock %}
