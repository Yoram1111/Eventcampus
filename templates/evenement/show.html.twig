{% extends 'layout/main.html.twig' %}

{% block title %}{{ evenement.titre }} - EventCampus{% endblock %}

{% block content %}
    <p><a href="{{ path('app_evenement_index') }}">← Tous les événements</a></p>

    <h1>{{ evenement.titre }}</h1>
    <img src="{{ asset('images/' ~ evenement.image) }}" width="400" alt="{{ evenement.titre }}">

    <p>{{ evenement.description }}</p>
    <ul>
        <li>Catégorie : {{ evenement.categorie }}</li>
        <li>Du {{ evenement.date_debut|date('d/m/Y à H:i') }} au {{ evenement.date_fin|date('d/m/Y à H:i') }}</li>
        <li>Lieu : {{ evenement.lieu }}</li>
        <li>Organisateur : {{ evenement.organisateur }}</li>
        <li>Prix : {{ evenement.prix == 0 ? 'Gratuit' : evenement.prix ~ ' €' }}</li>
        <li>Places : {% include 'components/remplissage.html.twig' %}</li>
    </ul>
{% endblock %}
