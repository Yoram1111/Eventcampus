{% extends 'layout/main.html.twig' %}

{% block title %}{{ categorie|capitalize }} - EventCampus{% endblock %}

{% block content %}
    <h1>Catégorie : {{ categorie|capitalize }}</h1>
    <p><a href="{{ path('app_evenement_index') }}">← Tous les événements</a></p>

    <div class="row">
        {% for evenement in evenements %}
            <div class="col-md-4 mb-4">{% include 'components/evenement_card.html.twig' %}</div>
        {% else %}
            <p>Aucun événement dans cette catégorie.</p>
        {% endfor %}
    </div>
{% endblock %}
