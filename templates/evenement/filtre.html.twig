{# Bonus : page HTML du filtre (même logique que le sujet 2) #}
{% extends 'layout/main.html.twig' %}

{% block title %}Filtrer - EventCampus{% endblock %}

{% block content %}
    <h1>Filtrer les événements</h1>

    <form>
        <select name="categorie">
            <option value="">Toutes les catégories</option>
            {% for cat in categories %}
                <option value="{{ cat }}" {{ cat == categorie ? 'selected' }}>{{ cat }}</option>
            {% endfor %}
        </select>
        <select name="acces">
            <option value="">Gratuit et payant</option>
            <option value="gratuit" {{ acces == 'gratuit' ? 'selected' }}>Gratuit</option>
            <option value="payant" {{ acces == 'payant' ? 'selected' }}>Payant</option>
        </select>
        <button>Filtrer</button>
    </form>

    <p>{{ evenements|length }} événement(s)</p>
    <ul>
        {% for evenement in evenements %}
            <li><a href="{{ path('app_evenement_show', {id: evenement.id}) }}">{{ evenement.titre }}</a> – {{ evenement.prix == 0 ? 'Gratuit' : evenement.prix ~ ' €' }}</li>
        {% else %}
            <li>Aucun événement ne correspond.</li>
        {% endfor %}
    </ul>
{% endblock %}
