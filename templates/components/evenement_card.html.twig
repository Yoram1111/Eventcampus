<div class="card">
    <img src="{{ asset('images/' ~ evenement.image) }}" class="card-img-top" alt="{{ evenement.titre }}">
    <div class="card-body">
        <b>{{ evenement.titre }}</b><br>
        {{ evenement.date_debut|date('d/m/Y à H:i') }}<br>
        {{ evenement.lieu }}<br>
        {% include 'components/remplissage.html.twig' %}<br>
        <a href="{{ path('app_evenement_show', {id: evenement.id}) }}">Voir le détail</a>
    </div>
</div>
